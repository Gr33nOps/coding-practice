<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="HAPPY_BIRTHDAY.MainPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <LinearGradientBrush x:Key="BackgroundGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF6B6B" Offset="0.0" />
                <GradientStop Color="#4ECDC4" Offset="0.5" />
                <GradientStop Color="#45B7D1" Offset="1.0" />
            </LinearGradientBrush>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid Background="{StaticResource BackgroundGradient}">
        <ScrollView>
            <StackLayout Spacing="30" Padding="20" VerticalOptions="CenterAndExpand">

                <!-- Birthday Cake Animation -->
                <Frame BackgroundColor="White" 
                       CornerRadius="20" 
                       HasShadow="True"
                       Padding="20"
                       x:Name="CakeFrame">
                    <Grid>
                        <Label Text="🎂" 
                               FontSize="80" 
                               HorizontalOptions="Center"
                               x:Name="CakeEmoji"/>
                        <Label Text="🕯️" 
                               FontSize="30" 
                               HorizontalOptions="Center"
                               VerticalOptions="Start"
                               Margin="0,-10,0,0"
                               x:Name="CandleEmoji"/>
                    </Grid>
                </Frame>

                <!-- Main Birthday Message -->
                <Frame BackgroundColor="White" 
                       CornerRadius="15" 
                       HasShadow="True"
                       Padding="20">
                    <StackLayout>
                        <Label Text="🎉 HAPPY BIRTHDAY! 🎉"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="#FF6B6B"
                               HorizontalOptions="Center"
                               x:Name="MainTitle"/>

                        <Entry Placeholder="Enter your friend's name"
                               FontSize="18"
                               HorizontalOptions="FillAndExpand"
                               x:Name="NameEntry"
                               TextChanged="OnNameChanged"
                               BackgroundColor="#F8F9FA"
                               Margin="0,10,0,0"/>

                        <Label x:Name="PersonalizedMessage"
                               FontSize="20"
                               FontAttributes="Italic"
                               TextColor="#333"
                               HorizontalOptions="Center"
                               Margin="0,15,0,0"
                               IsVisible="False"/>
                    </StackLayout>
                </Frame>

                <!-- Birthday Wishes -->
                <Frame BackgroundColor="White" 
                       CornerRadius="15" 
                       HasShadow="True"
                       Padding="20">
                    <StackLayout>
                        <Label Text="🌟 Birthday Wishes 🌟"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#4ECDC4"
                               HorizontalOptions="Center"
                               Margin="0,0,0,15"/>

                        <Label Text="May your special day be filled with happiness, laughter, and all your favorite things!"
                               FontSize="16"
                               TextColor="#555"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"/>

                        <Label Text="🎈 Hope all your birthday wishes come true! 🎈"
                               FontSize="16"
                               TextColor="#555"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               Margin="0,10,0,0"/>
                    </StackLayout>
                </Frame>

                <!-- Interactive Buttons -->
                <StackLayout Orientation="Horizontal" 
                           HorizontalOptions="Center"
                           Spacing="15">
                    <Button Text="🎵 Play Song"
                            BackgroundColor="#FF6B6B"
                            TextColor="White"
                            CornerRadius="25"
                            WidthRequest="120"
                            x:Name="SongButton"
                            Clicked="OnPlaySongClicked"/>

                    <Button Text="🎊 Celebrate"
                            BackgroundColor="#4ECDC4"
                            TextColor="White"
                            CornerRadius="25"
                            WidthRequest="120"
                            x:Name="CelebrateButton"
                            Clicked="OnCelebrateClicked"/>
                </StackLayout>

                <!-- Celebration Message -->
                <Frame BackgroundColor="White" 
                       CornerRadius="15" 
                       HasShadow="True"
                       Padding="20"
                       x:Name="CelebrationFrame"
                       IsVisible="False">
                    <StackLayout>
                        <Label x:Name="CelebrationMessage"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#FF6B6B"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"/>

                        <Label Text="🎉🎊🎈🎁🎂🎉🎊🎈🎁🎂"
                               FontSize="24"
                               HorizontalOptions="Center"
                               Margin="0,10,0,0"/>
                    </StackLayout>
                </Frame>

                <!-- Birthday Stats -->
                <Frame BackgroundColor="White" 
                       CornerRadius="15" 
                       HasShadow="True"
                       Padding="20">
                    <StackLayout>
                        <Label Text="🎯 Birthday Fun Facts"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#45B7D1"
                               HorizontalOptions="Center"
                               Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" 
                                   Text="🕐 Hours of fun ahead:" 
                                   FontSize="14" TextColor="#666"/>
                            <Label Grid.Row="0" Grid.Column="1" 
                                   Text="24+" 
                                   FontSize="14" FontAttributes="Bold" TextColor="#FF6B6B"/>

                            <Label Grid.Row="1" Grid.Column="0" 
                                   Text="🎁 Gifts deserved:" 
                                   FontSize="14" TextColor="#666"/>
                            <Label Grid.Row="1" Grid.Column="1" 
                                   Text="Unlimited!" 
                                   FontSize="14" FontAttributes="Bold" TextColor="#4ECDC4"/>

                            <Label Grid.Row="2" Grid.Column="0" 
                                   Text="😊 Smiles guaranteed:" 
                                   FontSize="14" TextColor="#666"/>
                            <Label Grid.Row="2" Grid.Column="1" 
                                   Text="∞" 
                                   FontSize="16" FontAttributes="Bold" TextColor="#45B7D1"/>
                        </Grid>
                    </StackLayout>
                </Frame>

            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>